# Copy this file to .env.local for local development. Never commit credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use local, preview, or production for the pre-deployment validation command.
# Keep each environment's URL, Supabase project and secrets isolated.
DEPLOYMENT_ENV=local

# Server-only opt-in for protected development QA pages. Production ignores a
# true value and always disables these utilities. Never use a NEXT_PUBLIC_ name.
ENABLE_QA_UTILITIES=false

# Public values available from the Supabase project's Connect dialog or API settings.
# Never use a secret key or service_role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional legacy fallback when the project still exposes an anon key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key used by the protected admin provisioning service.
# Prefer the current Supabase secret key. A legacy service_role key is supported
# as a fallback. Never prefix either variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only, independent random 32+ character key for HMAC rate-limit subjects.
# Required in production after the SEC-01 migration is reviewed and applied.
SECURITY_RATE_LIMIT_KEY=replace-with-independent-random-32-plus-character-secret

# Server-only bearer secret for the Supabase Cron automation endpoint. Use the
# same independently generated 32+ character value in Supabase Vault under the
# name zevantaa_automation_worker_token. Never prefix this with NEXT_PUBLIC_.
AUTOMATION_WORKER_SECRET=replace-with-independent-random-32-plus-character-secret
