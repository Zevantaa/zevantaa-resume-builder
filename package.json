{
  "name": "zevantaa-resume-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "security:audit": "npm audit --omit=dev",
    "security:sbom": "npm sbom --sbom-format cyclonedx --omit=dev",
    "security:secrets": "node scripts/check-secrets.mjs",
    "environment:validate": "node scripts/validate-environment.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Invoke-ZevantaaProductionRelease.ps1"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "mammoth": "1.13.0",
    "next": "16.4.1",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "word-extractor": "1.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/word-extractor": "1.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "argparse": "2.0.1"
  }
}
